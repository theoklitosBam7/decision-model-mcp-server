# Default backend. Per-call provider overrides are limited to DECISION_ALLOWED_PROVIDERS.
DECISION_PROVIDER=ollama
DECISION_ALLOWED_PROVIDERS=ollama

# Ollama decision models (Ollama 0.35+)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DECISION_MODEL=nimble
OLLAMA_TIMEOUT_MS=120000
# OLLAMA_KEEP_ALIVE=10m

# Hosted Jev
JEV_API_KEY=jv_live_your_key_here
JEV_API_BASE_URL=https://jevtypesafe.org/api/v1
JEV_TIMEOUT_MS=30000
# Development only. Never enable this for an untrusted network endpoint.
# JEV_ALLOW_INSECURE_HTTP=true
